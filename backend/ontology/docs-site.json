{
  "slice": "docs.public",
  "version": 1,
  "depth": "thesaurus",
  "kinds": ["doc", "research"],
  "classes": ["Page", "Claim", "Source", "Section"],
  "actions": ["draft", "publish", "unpublish", "redirect", "cite"],
  "axioms": [
    "a published page has exactly one canonical url",
    "a claim with no source is an opinion and is not published as fact"
  ],
  "terms": [
    { "id": "tutorial", "label": "tutorial", "aliases": ["getting started", "walkthrough", "onboarding guide"], "category": "page", "excludes": ["reference", "explanation"] },
    { "id": "how-to", "label": "how-to", "aliases": ["howto", "guide", "recipe", "task page"], "category": "page" },
    { "id": "reference", "label": "reference", "aliases": ["api docs", "lookup", "spec page"], "category": "page", "excludes": ["tutorial"] },
    { "id": "explanation", "label": "explanation", "aliases": ["concept page", "background", "why page"], "category": "page", "excludes": ["tutorial"] },
    { "id": "claim", "label": "claim", "aliases": ["assertion", "statement of fact"], "category": "content" },
    { "id": "citation", "label": "citation", "aliases": ["source link", "reference to source"], "category": "content" },
    { "id": "stale", "label": "stale", "aliases": ["out of date", "outdated", "rot"], "category": "condition" }
  ],
  "acceptance": {
    "doc": {
      "evidence": ["url:", "artifact:"],
      "gate": "the url resolves, the body hash matches the source file, and every claim carries a citation that resolves"
    },
    "research": {
      "evidence": ["source:", "url:"],
      "gate": "each claim maps to a source that exists and says what the claim says it says"
    }
  }
}
