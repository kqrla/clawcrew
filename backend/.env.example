# insforge is the only backend the build talks to
INSFORGE_URL=https://<appkey>.<region>.insforge.app
INSFORGE_API_KEY=

# 5432 is the fast path. sandboxes and locked-down CI image it out, so the https
# sql endpoint above is the fallback for anything that cannot open a socket.
DATABASE_URL=postgres://user:pass@<host>:5432/orchart

# root spend ceiling, usd/day, used by the authority model
ORCHART_ROOT_SPEND_USD=500
# spend above this needs a human approval card
ORCHART_SPEND_APPROVAL_USD=50
